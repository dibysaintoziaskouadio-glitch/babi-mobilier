# Base de données
# Connexion de l'application : rôle babi_app (soumis à la Row Level Security)
DATABASE_URL="postgresql://babi_app:mot-de-passe@localhost:5432/babi"
# Connexion propriétaire, utilisée uniquement par `npm run db:setup`
DATABASE_OWNER_URL="postgresql://postgres:postgres@localhost:5432/babi"

# Application
APP_URL="http://localhost:3000"
# Marchand affiché quand l'hôte n'a pas de sous-domaine (localhost, domaine principal)
DEFAULT_TENANT_SLUG="babi-mobilier"
# Domaine racine : atelier-kone.babimobilier.ci → tenant « atelier-kone »
ROOT_DOMAIN="babimobilier.ci"
# 32 caractères aléatoires minimum : openssl rand -base64 32
SESSION_SECRET="a-remplacer-par-une-longue-chaine-aleatoire"

# OTP : en mode dev, le code s'affiche dans la console du serveur au lieu d'être envoyé
OTP_DEV_MODE="true"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE="code_connexion"

# CinetPay
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
CINETPAY_TRANSFER_PASSWORD=""

# Job de rapprochement des paiements (appelé par Vercel Cron ou un cron système)
CRON_SECRET="a-remplacer"
